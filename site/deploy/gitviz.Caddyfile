# gitviz：静态产品（介绍页与 Mac 安装包）。按 vamyu 托管契约：
# 发布目录 /opt/gitviz/releases/<发布号>/，current 链接原子切换；本文件装到 /etc/personal-blog/sites/gitviz.Caddyfile。
git.vambda.com {
	encode zstd gzip
	root * /opt/gitviz/current/public
	@hidden path_regexp hidden (^|/)\.
	respond @hidden 404
	header {
		Strict-Transport-Security "max-age=2592000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
		-Server
	}
	# 页面、样式、脚本每次向源站确认，发布后立即可见；截图短期缓存。
	@pages path / /index.html /style.css /app.js
	header @pages Cache-Control "no-cache"
	@media path /img/*
	header @media Cache-Control "public, max-age=3600"
	# 安装包文件名带版本号，内容不再变化。
	@downloads path /downloads/*
	header @downloads Cache-Control "public, max-age=31536000, immutable"
	@dmg path *.dmg
	header @dmg Content-Type application/x-apple-diskimage
	file_server
}

# 兼容已发布的官网和下载链接，保留路径与查询参数。
gitviz.vambda.com {
	redir https://git.vambda.com{uri} 308
}
